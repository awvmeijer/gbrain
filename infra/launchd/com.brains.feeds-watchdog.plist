<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Mid-day feeds watchdog: catches a dead collector within hours instead of at
     the next 06:30 run. Runs infra/feeds-watchdog.py (diagnose, one remediation
     per unhealthy daily feed, re-import/embed if pages landed). Never posts.
     The 06:30 com.brains.feeds run calls the same script inline. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.brains.feeds-watchdog</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/awvmeijer/gbrain/sidecars/.venv/bin/python</string>
    <string>/Users/awvmeijer/gbrain/infra/feeds-watchdog.py</string>
  </array>
  <key>StartCalendarInterval</key>
  <array>
    <dict>
      <key>Hour</key>
      <integer>12</integer>
      <key>Minute</key>
      <integer>30</integer>
    </dict>
    <dict>
      <key>Hour</key>
      <integer>18</integer>
      <key>Minute</key>
      <integer>30</integer>
    </dict>
  </array>
  <key>RunAtLoad</key>
  <false/>
  <key>StandardOutPath</key>
  <string>/Users/awvmeijer/gbrain/logs/feeds-watchdog.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/awvmeijer/gbrain/logs/feeds-watchdog.log</string>
</dict>
</plist>
