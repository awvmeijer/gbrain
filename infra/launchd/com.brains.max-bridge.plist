<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.brains.max-bridge</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/awvmeijer/gbrain/sidecars/.venv/bin/python</string>
    <string>/Users/awvmeijer/gbrain/sidecars/max-bridge/server.py</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>MAXBRIDGE_PORT</key>
    <string>8789</string>
    <!-- claude CLI (Max-plan auth) lives in /opt/homebrew/bin; launchd's
         default PATH omits it, so the bridge's subprocess calls would fail. -->
    <key>PATH</key>
    <string>/opt/homebrew/bin:/Users/awvmeijer/gbrain/sidecars/.venv/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <key>WorkingDirectory</key>
  <string>/Users/awvmeijer/gbrain</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/Users/awvmeijer/gbrain/logs/max-bridge.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/awvmeijer/gbrain/logs/max-bridge.log</string>
</dict>
</plist>
